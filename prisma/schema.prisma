// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================================
// APP MODELS (SINGLE STORE)
// ==================================

// This model holds non-translatable category data.
model Category {
  id       String    @id @default(cuid())
  products Product[]

  // The 'name' is moved to the translation table below.
  // A category will have a list of its translations.
  translations CategoryTranslation[]
}

// This new model holds the translations for a Category.
model CategoryTranslation {
  id         String   @id @default(cuid())
  locale     String   // e.g., 'en', 'vi'
  name       String

  // Link back to the parent Category.
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  // Ensures a category can only have one name per language.
  @@unique([categoryId, locale])
}

// This model holds non-translatable product data.
model Product {
  id          String    @id @default(cuid())
  price       Float
  images      String[]
  stock       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Translatable fields are moved to the table below.
  translations ProductTranslation[]

  // Relations to other tables remain.
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  OrderItems  OrderItem[]
}

// This new model holds the translations for a Product.
model ProductTranslation {
  id          String  @id @default(cuid())
  locale      String  // e.g., 'en', 'vi'
  name        String
  description String? @db.Text
  slug        String

  // Link back to the parent Product.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ensures a product has one set of translations per locale,
  // and that the slug is unique for each language.
  @@unique([productId, locale])
  @@unique([locale, slug])
}

model Order {
  id        String      @id @default(cuid())
  isPaid    Boolean     @default(false)
  phone     String      @default("")
  address   String      @default("")
  createdAt DateTime    @default(now())

  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model PageLayout {
  id        String @id @default(cuid())
  pageName  String @unique
  content   Json
}

// ==================================
// AUTH MODELS (NextAuth.js)
// ==================================
//
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// MODEL 1: THE ELEMENT DEFINITION (BLUEPRINT)
// This stores the 'mold' for an element.
// e.g., Name: "Hero Banner", Identifier: "hero",
//       Schema: [{ "name": "title", "type": "text" }, { "name": "image", "type": "image" }]
model ElementBlueprint {
  id         String   @id @default(cuid())
  name       String // The human-friendly name, e.g., "Hero Banner"
  identifier String   @unique // The machine-friendly ID, e.g., "hero_banner"
  
  // This JSON field stores the structure of the element
  schema     Json
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// MODEL 2: THE PAGE CONTENT (INSTANCE)
// This stores the actual content for a page, like the homepage.
model Page {
  id    String @id @default(cuid())
  name  String // e.g., "Homepage"
  slug  String @unique // e.g., "/" or "about-us"
  
  // This JSON field stores the list of elements on this page
  // Example: [{ "elementId": "uuid", "type": "hero_banner", "data": { "title": "..." } }]
  content Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}